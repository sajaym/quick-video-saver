{
  "manifest_version": 3,
  "name": "Quick Video Saver",
  "version": "2.0.0",
  "description": "Find and save videos from almost any page: direct files, HLS/DASH streams and site links. Free, no quota, no account. Works in a popup or the side panel.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads",
    "webRequest",
    "webNavigation",
    "scripting",
    "sidePanel",
    "nativeMessaging",
    "declarativeNetRequest",
    "contextMenus",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Quick Video Saver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject/overlay.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject/hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Open Quick Video Saver"
    },
    "open-sidepanel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open Quick Video Saver in the side panel"
    }
  },
  "key": ""
}
